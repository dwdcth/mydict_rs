# 复制为 .env 后按需修改；全部可省略，默认值见 README

# JWT 密钥（留空自动生成并持久化到 /data/config/jwt_secret.key）
#JWT_SECRET=

# 开放使用：开启后 Web 与 v1 API 允许匿名查询（按 IP 限流）
#OPEN_ACCESS_DEFAULT=false
# 允许自助注册
#ALLOW_REGISTRATION_DEFAULT=true

# Token 每日配额默认值
#TOKEN_DEFAULT_DAILY_LIMIT=1000
# 匿名/登录用户单 IP 每分钟查询上限
#ANONYMOUS_IP_RATE_LIMIT_PER_MIN=60
#USER_IP_RATE_LIMIT_PER_MIN=120
# 上传单次总大小上限（MB）
#MAX_UPLOAD_SIZE_MB=512
# 统计聚合定时任务（进程内）
#ENABLE_SCHEDULER=true

# 「一天」的时区（IANA 名，如 Asia/Shanghai；留空用系统时区）
#TIMEZONE=

# 数据目录（默认 /data/*）
#CONFIG_STORAGE_PATH=/data/config
#DICTS_INBOX_PATH=/data/dicts
#DATABASE_PATH=/data/db/mydict.sqlite3
# 非空则优先（支持 postgres:// / mysql://）
#DATABASE_URL=
#DICTIONARY_STORAGE_PATH=/data/dictionaries
#LOG_DIR=/data/logs

# 在线词典出站代理（管理后台可覆盖）
#ONLINE_DICT_PROXY=
